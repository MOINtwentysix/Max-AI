# ==============================================================================
# Max – Personal AI Buddy (.env Configuration)
# ==============================================================================

# Port on the host machine
PORT=3000

# Secret key used for signing JWT authentication tokens
# IMPORTANT: Generate a strong random string for production deployments!
JWT_SECRET=max_super_secret_jwt_random_string_replace_with_your_own

# Connection URL to your Ollama instance
# When Ollama is running directly on the host machine outside Docker:
# Use http://host.docker.internal:11434 (configured via host-gateway in docker-compose.yml)
# Or if on a remote server/LAN: http://192.168.1.100:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Default Ollama model to use for conversations and memory processing
# E.g. llama3.2:latest, llama3.1:8b, mistral:7b, gemma2:9b, etc.
OLLAMA_MODEL=llama3.2:latest

# Local data storage path (inside container defaults to /app/data)
DATA_DIR=/app/data
